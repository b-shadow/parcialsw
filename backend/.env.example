APP_NAME=Plataforma CASE Inteligente
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://case_user:case_password@localhost:5433/case_inteligente
JWT_SECRET_KEY=change-me-in-development
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://case-inteligente.vercel.app,https://case-inteligente-v2.vercel.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b
OLLAMA_SMALL_MODEL=qwen2.5-coder:1.5b
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct
OLLAMA_VISION_ENABLED=true
OLLAMA_VISION_TIMEOUT_SECONDS=900
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_READ_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=10m
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=12000
AI_MAX_CONTEXT_CHARS=50000
AI_TEMPERATURE=0
AI_RULE_FALLBACK_ENABLED=true
AI_MAX_CONCURRENT_REQUESTS=2
AI_MESSAGES_PER_MINUTE=12
AI_MAX_CONCURRENT_PER_USER_PROJECT=1
PROJECT_SNAPSHOT_MAX_BYTES=8388608
NOTIFICATION_OUTBOX_BATCH_SIZE=50
# Directorio opcional con modelos Tesseract (por ejemplo eng.traineddata y spa.traineddata).
CASE_TESSDATA_DIR=

# Redis y NoSQL
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=case
REDIS_CHANGE_LOG_MAXLEN=10000

# Bloqueos e IA Proactiva
ELEMENT_LOCK_TTL_SECONDS=60
AI_PROACTIVE_ENABLED=true
AI_PROACTIVE_MIN_CHANGES=5
AI_PROACTIVE_COOLDOWN_SECONDS=120

# Gemini opcional (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
