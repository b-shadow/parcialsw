APP_NAME=Plataforma CASE Inteligente
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://case_user:case_password@localhost:5433/case_inteligente
MONGODB_URI=mongodb://case_user:case_password@localhost:27018/?authSource=admin
MONGODB_DATABASE=case_inteligente_nosql
MONGODB_ENABLED=true
MONGODB_REQUIRED=true
UML_VERSIONS_MONGODB_READ_ENABLED=true
UML_VERSIONS_SQL_FALLBACK_ENABLED=false
UML_VERSIONS_COMPARE_READS=false
UML_VERSIONS_MIGRATION_BATCH_SIZE=200
UML_VERSIONS_MIGRATION_REQUIRED=false
UML_DIAGRAMS_MONGODB_READ_ENABLED=true
UML_DIAGRAMS_SQL_FALLBACK_ENABLED=false
UML_DIAGRAMS_COMPARE_READS=false
UML_DIAGRAMS_DUAL_WRITE_ENABLED=false
UML_DIAGRAMS_MIGRATION_BATCH_SIZE=100
UML_DIAGRAMS_MIGRATION_REQUIRED=false
NOSQL_CONSOLIDATED_MODE=true
NOSQL_RECONCILIATION_INTERVAL_SECONDS=300
NOSQL_RECONCILIATION_REQUIRED=false
NOSQL_RECONCILIATION_MAX_AGE_SECONDS=900
NOSQL_ALERT_PENDING_OUTBOX=100
NOSQL_ALERT_DEAD_OUTBOX=1
NOSQL_ALERT_MAX_DOCUMENT_BYTES=12000000
NOSQL_ALERT_MAX_REVISION_LAG=0
NOSQL_BACKUP_PATH=../storage/backups
PHASE14_CONSOLIDATION_REQUIRED=false
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_OUTBOX_BATCH_SIZE=50
MONGODB_OUTBOX_MAX_ATTEMPTS=8
AI_MESSAGES_MONGODB_READ_ENABLED=true
AI_MESSAGES_SQL_FALLBACK_ENABLED=false
AI_MESSAGES_COMPARE_READS=false
AI_MESSAGES_MIGRATION_BATCH_SIZE=200
AI_MESSAGES_MIGRATION_REQUIRED=false
JWT_SECRET_KEY=change-me-in-development
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://case-inteligente.vercel.app,https://case-inteligente-v2.vercel.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b
OLLAMA_SMALL_MODEL=qwen2.5-coder:1.5b
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct
OLLAMA_VISION_ENABLED=true
OLLAMA_VISION_TIMEOUT_SECONDS=900
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_READ_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=10m
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=12000
AI_MAX_CONTEXT_CHARS=50000
AI_TEMPERATURE=0
AI_RULE_FALLBACK_ENABLED=true
AI_MAX_CONCURRENT_REQUESTS=2
AI_MESSAGES_PER_MINUTE=12
AI_MAX_CONCURRENT_PER_USER_PROJECT=1
PROJECT_SNAPSHOT_MAX_BYTES=8388608
NOTIFICATION_OUTBOX_BATCH_SIZE=50
# Directorio opcional con modelos Tesseract (por ejemplo eng.traineddata y spa.traineddata).
CASE_TESSDATA_DIR=
