POSTGRES_DB=case_inteligente
POSTGRES_USER=case_user
POSTGRES_PASSWORD=replace-with-strong-database-password
MONGO_ROOT_USERNAME=case_user
MONGO_ROOT_PASSWORD=replace-with-strong-mongodb-password
MONGODB_DATABASE=case_inteligente_nosql
UML_VERSIONS_MONGODB_READ_ENABLED=true
UML_VERSIONS_SQL_FALLBACK_ENABLED=false
UML_VERSIONS_COMPARE_READS=false
UML_VERSIONS_MIGRATION_BATCH_SIZE=200
UML_VERSIONS_MIGRATION_REQUIRED=false
UML_DIAGRAMS_MONGODB_READ_ENABLED=true
UML_DIAGRAMS_SQL_FALLBACK_ENABLED=false
UML_DIAGRAMS_COMPARE_READS=false
UML_DIAGRAMS_DUAL_WRITE_ENABLED=false
UML_DIAGRAMS_MIGRATION_BATCH_SIZE=100
UML_DIAGRAMS_MIGRATION_REQUIRED=false
NOSQL_CONSOLIDATED_MODE=true
NOSQL_RECONCILIATION_INTERVAL_SECONDS=300
NOSQL_RECONCILIATION_REQUIRED=true
NOSQL_RECONCILIATION_MAX_AGE_SECONDS=900
NOSQL_ALERT_PENDING_OUTBOX=100
NOSQL_ALERT_DEAD_OUTBOX=1
NOSQL_ALERT_MAX_DOCUMENT_BYTES=12000000
NOSQL_ALERT_MAX_REVISION_LAG=0
NOSQL_BACKUP_PATH=/storage/backups
PHASE14_CONSOLIDATION_REQUIRED=true
AI_MESSAGES_MONGODB_READ_ENABLED=true
AI_MESSAGES_SQL_FALLBACK_ENABLED=false
AI_MESSAGES_COMPARE_READS=false
AI_MESSAGES_MIGRATION_BATCH_SIZE=200
AI_MESSAGES_MIGRATION_REQUIRED=false
JWT_SECRET_KEY=replace-with-64-byte-random-secret
CORS_ORIGINS=https://app.tu-dominio.com,https://tu-dominio.com
ALLOWED_HOSTS=api.tu-dominio.com,tu-dominio.com,localhost,127.0.0.1
AWS_REGION=us-east-1
S3_ARTIFACTS_BUCKET=case-inteligente-artifacts
PUBLIC_API_BASE_URL=https://api.tu-dominio.com/api/v1
PUBLIC_WS_BASE_URL=wss://api.tu-dominio.com
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@tu-dominio.com
