aws_region            = "us-east-1"
project_name          = "case-inteligente"
domain_name           = "tu-dominio.com"
frontend_domain       = "app.tu-dominio.com"
api_domain            = "api.tu-dominio.com"
frontend_external_url = "https://case-inteligente.vercel.app"
frontend_allowed_origins = [
  "https://case-inteligente.vercel.app",
  "https://case-inteligente-v2.vercel.app",
]
enable_cloudfront     = false
route53_zone_id       = "ZXXXXXXXXXXXXX"
backend_image         = "123456789012.dkr.ecr.us-east-1.amazonaws.com/case-inteligente-backend:latest"
frontend_bucket_name  = "case-inteligente-frontend-tu-dominio"
artifacts_bucket_name = "case-inteligente-artifacts-tu-dominio"
database_name         = "case_inteligente"
database_username     = "case_user"
mongodb_database      = "case_inteligente_nosql"
jwt_secret_arn        = "arn:aws:secretsmanager:us-east-1:123456789012:secret:case-jwt-EXAMPLE"
mongodb_uri_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:case-mongo-EXAMPLE"
ollama_base_url       = "http://10.20.11.10:11434"
# Para crear Ollama en EC2 GPU: enable_aws_ollama = true y ollama_base_url = null.
enable_aws_ollama     = false
ollama_instance_type  = "g6.xlarge"
redis_url_secret_arn  = null
rds_backup_retention_period = 7
ec2_instance_type     = "t3.small"
ec2_key_name          = null
enable_ssh            = false
admin_ssh_cidr        = "TU_IP_PUBLICA/32"
